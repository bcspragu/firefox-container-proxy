{
  "manifest_version": 3,
  "name": "Container proxy",
  "version": "0.1.22",
  "description": "__MSG_General_extensionDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "contaner-proxy@bekh-ivanov.me",
      "strict_min_version": "115.0"
    }
  },
  "action": {
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "contextualIdentities",
    "proxy"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "scripts": [
      "background/index.js"
    ]
  }

}
